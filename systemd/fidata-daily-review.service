[Unit]
Description=fiData daily Claude summary (Telegram)
After=network-online.target

[Service]
Type=oneshot
User=ai1
WorkingDirectory=/home/ai1/apps/fidata
EnvironmentFile=/home/ai1/apps/fidata/.env
ExecStart=/home/ai1/apps/fidata/venv/bin/python run_daily_review.py
StandardOutput=journal
StandardError=journal
