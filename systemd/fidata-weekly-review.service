[Unit]
Description=fiData weekly deep review (Telegram digest + panel report)
After=network-online.target

[Service]
Type=oneshot
User=ai1
WorkingDirectory=/home/ai1/apps/fidata
EnvironmentFile=/home/ai1/apps/fidata/.env
ExecStart=/home/ai1/apps/fidata/venv/bin/python run_weekly_review.py
StandardOutput=journal
StandardError=journal
